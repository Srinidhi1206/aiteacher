# mAITeacher - environment variables reference
# Copy this file to .env.local and fill in real values for your environment.
# Nothing in this file is a real secret.

# Disable Next.js anonymous telemetry (optional).
NEXT_TELEMETRY_DISABLED=1

# --- Demo authentication (Step 1) ---------------------------------------
# Signs/verifies the session cookie (lib/auth/session.ts). Set this to a
# long random string in any real deployment - if unset, a dev-only default
# is used and sessions are trivially forgeable.
SESSION_SECRET=

# Optional overrides for the 7 hardcoded demo accounts (lib/auth/users.ts).
# If unset, the in-code defaults documented in docs/DEMO_CREDENTIALS.md are
# used. Set these before sharing a deployed link with anyone outside your
# team.
ADMIN_PASSWORD=
TEACHER_PASSWORD=
STUDENT1_PASSWORD=
STUDENT2_PASSWORD=
STUDENT3_PASSWORD=
STUDENT4_PASSWORD=
STUDENT5_PASSWORD=

# --- Database (Stage A - schema/tooling exist, not yet wired to the UI) --
# See docs/DATABASE.md for exact setup steps. Nothing in the app reads/
# writes through Prisma yet (lib/mock-data/* is still the source of truth
# for every page) - these only need to be set once you actually want to run
# `npm run db:migrate` / `npm run db:seed` against a real database.
#
# DATABASE_URL: the connection string the app queries through at runtime.
# For Vercel Postgres / Neon, use the POOLED connection string here.
DATABASE_URL=
#
# DIRECT_URL: a NON-POOLED connection string to the same database, used only
# by `prisma migrate`/`prisma db seed` (schema changes can't run through a
# pgbouncer pool). If your provider only gives you one connection string,
# set this to the same value as DATABASE_URL.
DIRECT_URL=

# --- Future: cloud file storage (Stage: Study Materials, not wired yet) --
# Vercel Blob token, once you create a Blob store from the Vercel dashboard.
# BLOB_READ_WRITE_TOKEN=

# --- Future: AI Tutor provider (Stage G, not wired yet - mocked until then)
# Only ONE of these is needed, matching whichever provider you activate.
# Server-side only - never exposed to the browser.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
