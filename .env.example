# mAITeacher - environment variables reference
# Copy this file to .env.local and fill in real values for your environment.
# Nothing in this file is a real secret.

# Disable Next.js anonymous telemetry (optional).
NEXT_TELEMETRY_DISABLED=1

# --- Demo authentication (Step 1) ---------------------------------------
# Signs/verifies the session cookie (lib/auth/session.ts). Set this to a
# long random string in any real deployment - if unset, a dev-only default
# is used and sessions are trivially forgeable.
SESSION_SECRET=

# Optional overrides for the 7 hardcoded demo accounts (lib/auth/users.ts).
# If unset, the in-code defaults documented in docs/DEMO_CREDENTIALS.md are
# used. Set these before sharing a deployed link with anyone outside your
# team.
ADMIN_PASSWORD=
TEACHER_PASSWORD=
STUDENT1_PASSWORD=
STUDENT2_PASSWORD=
STUDENT3_PASSWORD=
STUDENT4_PASSWORD=
STUDENT5_PASSWORD=

# --- Future backend (not used yet - see docs/ARCHITECTURE.md) -----------
# Uncomment and set once Postgres + Prisma are actually wired up. Prisma is
# not run against a live database in this build.
# DATABASE_URL=
