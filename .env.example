# mAITeacher - environment variables reference
# Copy this file to .env.local and fill in real values for your environment.
# Nothing in this file is a real secret. NODE_ENV is set automatically by
# the `next` CLI (dev/build/start) - never set it manually here.
#
# Every variable below is labeled with when it's actually needed:
#   [REQUIRED IN PRODUCTION]  - the app fails closed without it once
#                                NODE_ENV=production (see lib/auth/session.ts
#                                and lib/auth/users.ts) - never silently
#                                falls back to something insecure.
#   [OPTIONAL / PROVIDER]     - only needed to enable a specific feature
#                                (file uploads, AI Tutor). Its absence
#                                degrades that one feature gracefully -
#                                never a fake success, never a crash.
#   [DEVELOPMENT-ONLY]        - only read/used when NODE_ENV !== "production".

NEXT_TELEMETRY_DISABLED=1

# --- Session signing (lib/auth/session.ts) --------------------------------
# [REQUIRED IN PRODUCTION] Signs/verifies the session cookie. In production
# (NODE_ENV=production), leaving this unset makes session
# signing/verification throw a configuration error instead of silently
# using a well-known development secret - login then fails closed with a
# generic "temporarily unavailable" message (see
# app/api/auth/login/route.ts), and any request presenting a session
# cookie is refused. In development, an insecure built-in default is used
# automatically so local setup needs no extra steps - set a real value
# with `openssl rand -base64 32` (or equivalent) for any real deployment.
SESSION_SECRET=

# --- Demo/fallback accounts (lib/auth/users.ts) ---------------------------
# [DEVELOPMENT-ONLY] Optional overrides for the 7 hardcoded demo accounts -
# see docs/DEMO_CREDENTIALS.md. Only read when DATABASE_URL is unset AND
# NODE_ENV !== "production" - in production with no DATABASE_URL, login
# fails closed instead of ever considering these accounts (see Stage I,
# docs/STEP_3_5.md). Never used once a real database is connected.
ADMIN_PASSWORD=
TEACHER_PASSWORD=
STUDENT1_PASSWORD=
STUDENT2_PASSWORD=
STUDENT3_PASSWORD=
STUDENT4_PASSWORD=
STUDENT5_PASSWORD=

# --- Database (prisma/schema.prisma, lib/prisma.ts) -----------------------
# [REQUIRED IN PRODUCTION] See docs/DATABASE.md for exact setup and
# migration steps. Every database-backed page/action degrades to a
# `DatabaseUnavailable` state (or, for login specifically, fails closed -
# see SESSION_SECRET above) when these are unset or the database is
# unreachable - nothing pretends to work against a database that isn't
# there. In development, leaving both unset is fully supported and keeps
# the app on the demo-account fallback path.
#
# DATABASE_URL: the connection string the app queries through at runtime.
# For Vercel Postgres / Neon, use the POOLED connection string here.
DATABASE_URL=
#
# DIRECT_URL: a NON-POOLED connection string to the same database, used only
# by `prisma migrate`/`prisma db seed` (schema changes can't run through a
# pgbouncer pool). If your provider only gives you one connection string,
# set this to the same value as DATABASE_URL.
DIRECT_URL=

# --- Cloud file storage (lib/storage/*) -----------------------------------
# [OPTIONAL / PROVIDER] Vercel Blob read/write token. Create a Blob store
# from your Vercel project's Storage tab, copy its token here. Without this
# set, uploads (Admin Study Materials, Teacher Worksheets, Teacher Exam
# Papers) fail with a clear "storage is not configured" error - the app
# still builds and runs, uploads are just disabled until this is set. Not
# required for the app to be otherwise production-ready.
BLOB_READ_WRITE_TOKEN=

# --- AI Tutor provider (lib/ai/*) ------------------------------------------
# [OPTIONAL / PROVIDER] Selects which provider lib/ai/provider.ts uses.
# Leave unset (or empty) to leave the AI Tutor gracefully "not configured" -
# the app still builds and runs, and /ai-tutor shows a clear "not
# configured yet" state instead of crashing or faking a response. Not
# required for the app to be otherwise production-ready.
#   gemini - the only real provider implemented so far. Requires GEMINI_API_KEY.
#   openai - reserved for a later stage; the provider interface already
#            supports adding it, but no implementation exists yet.
#   mock   - [DEVELOPMENT-ONLY] reuses lib/socratic-engine.ts's canned
#            responses. Refused at runtime when NODE_ENV=production, so a
#            deployment can never silently serve fake AI responses.
AI_PROVIDER=

# [OPTIONAL / PROVIDER] Required only when AI_PROVIDER=gemini. Server-side
# only - never exposed to the browser, never read by any Client Component.
GEMINI_API_KEY=
# Optional - defaults to gemini-2.5-flash if unset.
# GEMINI_MODEL=

# Reserved for a later stage (see AI_PROVIDER above) - not read by any code yet.
OPENAI_API_KEY=
